// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PRODUCER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Product{
  id String @id @default(uuid())
  name String  @unique
  description String?
  price Int //Kuruş cinsinden
  stock Int @default(0) 
  imageUrl  String?
  isActive Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  searchVector Unsupported("tsvector")? @default(dbgenerated()) // SQL

  // ilişkiler

  category Category? @relation(fields: [categoryId], references:[id], onDelete:SetNull)
  categoryId String?

  producer Producer? @relation(fields:[producerId], references:[id], onDelete:SetNull)
  producerId String?

  ownerId String?
  owner User? @relation("ProductOwner", fields:[ownerId], references:[id], onDelete:SetNull)

  tags Tag[]

  reviews Review[]

   wishlist WishlistItem[]

   images    ProductImage[]

  cartItems CartItem[]

  orderItems OrderItem[]

  @@map("products")

  @@index([searchVector], type:Gin)
  // @@unique()
  // @@index([name])
  // @@id([id,productId])
}

model Category {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //ilişkiler
  products Product[]

  @@map("categories")
}

model Producer {
  id        String    @id @default(uuid())
  name      String    @unique
  city      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("producers")
}

model Tag{
  id  String @id @default(uuid())
  name String @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@map("tags")
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String //bcrypt
  role Role @default(CUSTOMER)
  isActive Boolean @default(true)
  isVerified Boolean @default(false)
  deletedAt DateTime?

  // email verification
  verificationToken String?
  verificationTokenExpiry DateTime?

  // password
  resetToken String?
  resetTokenExpiry DateTime?

  ownerProducts Product[] @relation("ProductOwner")

  // ilişkiler
  refreshTokens RefreshToken[]

  reviews Review[]

   wishlist WishlistItem[]

  addresses Address[]

  cart Cart?

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt


  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())
  token String @unique
  userId String 
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)

  expiresAt DateTime 
  revokedAt DateTime?
  replacedBy String? 
  userAgent String? 
  ipAddress String?

  createdAt DateTime @default(now())

  @@map("refresh_tokens")

}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

   product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Review {
  id        String    @id @default(uuid())
  userId    String
  productId String
  rating    Int       // 1-5
  comment   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// Enes
model Address {
  id String @id @default(uuid())
  userId String
  title String
  fullName String // teslimatı alacak kişinin adı
  phone String
  city String
  district String
  fullAddress String
  isDefault Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// Sinan
model Cart {
  id String @id @default(uuid())
  userId String @unique
  couponId String?
  items CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)


  @@index([userId])
  @@map("carts")
}

// Sinan
model CartItem {
  id String @id @default(uuid())
  cartId String
  productId String
  quantity Int @default(1)
  price Int //Kuruş cinsinden, eklenme anındaki fiyat
  createdAt DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// Erdem
model Coupon {
  id String @id @default(uuid())
  code String @unique // "BAYRAM25"
  discountType DiscountType
  discountValue Int // percentage için 1-100, fixed için kuruş cinsinden
  minOrderAmount Int
  maxUsage Int? // null ise sınırsız
  expiresAt DateTime? // null ise süresiz
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  carts Cart[]

  orders Order[]

  @@map("coupons")
}

model Order {
  id String @id @default(uuid())
  userId String
  addressId String
  couponId String?
  trackingNumber String? 

  subtotal Int
  discountAmount Int @default(0)
  totalAmount Int

  status OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  address Address @relation(fields: [addressId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String
  quantity Int
  price Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Log {
  id        String   @id @default(uuid())
  level     String   // warn, error
  message   String
  meta      Json?    // requestId, url, stack...
  createdAt DateTime @default(now())

  @@map("logs")
}

//! Sipariş adımları

// 1-idempotencyKey, kullanıcı bu anahtarla daha önce sipariş vermiş mi?
// 2-Kullanıcının sepetindeki ürünleri alıyoruz. (ürünler + kupon)
// 3-sepette ürün var mı?
// 4-verilen adres kullanıcıya ait mi?
// 5-tutarları hesaplıyoruz (ara toplam, indirim, genel toplam)
// 6-stok yeterli mi?
// 7-transaction başlatıyoruz
//   7.1-Order + orderItem kaydını oluşturuyoruz (status: PENDING
//   7.2-stok güncelliyoruz (yeni stok = eski stok - sipariş miktarı)
//   7.3-kupon kullanıldıysa kullanım sayısını artırıyoruz
//   7.4-sepeti temizliyoruz
// 8-siparişe geri dönüyoruz
